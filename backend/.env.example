# ─── Obbligatorie ───
# Chiave API Anthropic (Claude). Crea la chiave su console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Segreto per firmare i cookie di sessione (stringa lunga e casuale)
JWT_SECRET=metti-qui-una-stringa-lunga-e-casuale

# Origini permesse dal CORS (il sito + eventuale dominio proprietario), separate da virgola
ALLOWED_ORIGINS=https://arabianlove.github.io,http://localhost:8080

# ─── Persistenza (consigliata) ───
# Database Postgres di Railway. Senza questa, i dati stanno solo in memoria
# e si azzerano a ogni riavvio/deploy.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── Opzionali: scelta modelli e potenza ───
# Modalità normale (veloce ed economica)
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096
AI_EFFORT=medium
# God Mode (massima potenza). Per il massimo assoluto: claude-opus-4-8
AI_MODEL_GODMODE=claude-opus-4-8
AI_MAX_TOKENS_GODMODE=16000
AI_EFFORT_GODMODE=high

# Porta (Railway la imposta da solo; in locale usa 3000)
PORT=3000
